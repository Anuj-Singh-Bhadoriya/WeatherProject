<Window x:Class="WeatherAppApi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WeatherAppApi.Views"
        Title="Weather AI App"
        Height="600"
        Width="900">

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
           
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        
        
        <!-- Left Panel -->
        <StackPanel Grid.Column="0">
            <views:WeatherView DataContext="{Binding WeatherVM}" />

          
        </StackPanel>

        <!-- Right Panel -->
        <StackPanel Grid.Column="1"
                    Margin="5,0,0,0">
            <views:ChatMessageView DataContext="{Binding ChatMessageVM}"/>

            
        </StackPanel>

    </Grid>

</Window>