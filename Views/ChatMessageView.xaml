<UserControl x:Class="WeatherAppApi.Views.ChatMessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F5F5">

        <Border Background="White"
                Margin="20"
                Padding="20"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel>

                <!-- Header -->
                <TextBlock Text="🤖 AI Weather Assistant"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- Chat Messages -->
                <ListBox 
                    x:Name="ChatListBox"
                    Height="450"
                 ItemsSource="{Binding Messages}"
                 BorderThickness="0">
                    
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Grid>

                                <Border x:Name="ChatBorder"
                                    Background="LightGreen"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="5"
                                    MaxWidth="350"
                                    HorizontalAlignment="{Binding MessageAlignment}">

                                    <StackPanel>

                                        <TextBlock FontWeight="Bold">
                                          <Run Text="{Binding Sender}"/>
                                        </TextBlock>

                                        <TextBlock Text="{Binding Message}"
                                            TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Time}"
                                           FontSize="10"
                                           Foreground="Gray"
                                           HorizontalAlignment="Right"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                            <DataTemplate.Triggers>

                                <DataTrigger Binding="{Binding IsUser}"
                                   Value="True">

                                    <Setter TargetName="ChatBorder"
                                        Property="HorizontalAlignment"
                                        Value="Left"/>

                                    <Setter TargetName="ChatBorder"
                                        Property="Background"
                                        Value="LightBlue"/>

                                </DataTrigger>

                            </DataTemplate.Triggers>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

                <Button Content="Clear"
                    Width="90"
                    Height="30"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    Command="{Binding ClearChatCommand}" />


            </StackPanel>

        </Border>

      

    </Grid>

</UserControl>