<UserControl x:Class="WeatherAppApi.Views.WeatherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WeatherAppApi.Converters"
             >
    <UserControl.Resources>

        <conv:BoolToVisibilityConverter
            x:Key="BoolToVisibilityConverter"/>

        <conv:InverseBooleanConverter
            x:Key="InverseBooleanConverter"/>
        
    </UserControl.Resources>
    
    <Grid Background="#F5F5F5">

        <Border Background="White"
                Margin="20"
                Padding="20"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel>

                <!-- Header -->
                <TextBlock Text="🌤 Weather Information"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- City Input -->
                <TextBlock Text="Enter City"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox Height="35"
                         Margin="0,0,0,15"
                        Text="{Binding City}"/>

                <Button Content="Get Weather"
                        Height="40"
                        Width="140"
                        HorizontalAlignment="Left"
                        Command="{Binding GetWeatherCommand}"
                        IsEnabled="{Binding IsLoading,Converter={StaticResource InverseBooleanConverter}}"
                        />
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="Red"
                           FontWeight="Bold"
                           Margin="0,10,0,10"
                           
                           />
                <ProgressBar 
                    Height="10"
                    Margin="0,10,0,10"
                    IsIndeterminate="True"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    />

                <Separator Margin="0,20,0,20"/>

                <!-- Weather Details -->
                <TextBlock Text="{Binding WeatherIcon}"
                   FontSize="30"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

                <TextBlock Text="Weather Details"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

                <Border Background="#FAFAFA"
                     CornerRadius="5"
                    Padding="15"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Visibility="{Binding HasWeatherData,
                                         Converter={StaticResource BoolToVisibilityConverter}}">

                  
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>

                        <!-- Labels -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="City :"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Temperature :"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Humidity :"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Condition :"
                                   FontWeight="SemiBold"/>

                        <!-- Values -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding City}"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Temperature,StringFormat={}{0}°C}"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding Humidity,StringFormat={}{0}%}"/>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding Condition}"/>

                    </Grid>

                </Border>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>