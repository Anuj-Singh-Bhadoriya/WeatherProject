<UserControl x:Class="WeatherAppApi.Views.WeatherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F5F5">

        <Border Background="White"
                Margin="20"
                Padding="20"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel>

                <!-- Header -->
                <TextBlock Text="🌤 Weather Information"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- City Input -->
                <TextBlock Text="Enter City"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox Height="35"
                         Margin="0,0,0,15"
                        Text="{Binding City}"/>

                <Button Content="Get Weather"
                        Height="40"
                        Width="140"
                        HorizontalAlignment="Left"
                        Command="{Binding GetWeatherCommand}"
                        />

                <Separator Margin="0,20,0,20"/>

                <!-- Weather Details -->
                <TextBlock Text="Weather Details"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <Border BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Padding="10">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>

                        <!-- Labels -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="City :"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Temperature :"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Humidity :"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Condition :"
                                   FontWeight="SemiBold"/>

                        <!-- Values -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding City}"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Temperature,StringFormat={}{0}°C}"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding Humidity,StringFormat={}{0}%}"/>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding Condition}"/>

                    </Grid>

                </Border>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>